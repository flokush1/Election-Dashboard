# Environment Configuration
# Copy this file to .env and customize as needed

FLASK_ENV=development
FLASK_HOST=127.0.0.1
FLASK_PORT=5000
FLASK_DEBUG=False

# Data locations
DATA_ROOT=.
PRIVATE_DATA_DIR=data/private
PUBLIC_DATA_DIR=public/data
PREDICTIONS_DIR=data/private/predictions
MODELS_DIR=data/private/models
VOTER_ROLLS_DIR=data/private/voter_rolls
EXCEL_DATA_PATH=data/private/raw/NewDelhi_Parliamentary_Data.xlsx

FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

MAX_EXCEL_UPLOAD_MB=50
MAX_MODEL_UPLOAD_MB=200
LOG_LEVEL=INFO
EXPOSE_DEBUG_ENDPOINTS=true
INCLUDE_TRACEBACKS=true
