# Environment Configuration (Optional)
# Copy this file to .env and customize as needed

# Flask Server Configuration
FLASK_HOST=127.0.0.1
FLASK_PORT=5000
FLASK_DEBUG=False

# Data Paths (Optional - defaults to root directory)
# EXCEL_DATA_PATH=NewDelhi_Parliamentary_Data.xlsx
# PREDICTIONS_DIR=./

# Model Configuration (Optional)
# DEFAULT_MODEL_PATH=Prediction Models/YourAssembly/model.pkl

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173

# Upload Limits
MAX_UPLOAD_SIZE_MB=100

# Logging
LOG_LEVEL=INFO
